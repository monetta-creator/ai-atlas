# ---- Runtime database connection (REQUIRED) ----
# One supported path: any reachable Postgres 15+. The app and every db:* script
# read this. TLS is used only when the URL carries sslmode=require (or DB_SSL=1).
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/strategy_atlas
# Connections per server process (default 3). Behind a shared pooler, use 1.
# DB_POOL_MAX=3

# ---- Admin gate (REQUIRED) ----
# Choose a strong admin password. AUTH_SECRET signs the admin session cookie and
# MUST be set (the app throws if it is missing or shorter than 32 chars).
ADMIN_PASSWORD=<choose-a-strong-password>
AUTH_SECRET=<random-string-at-least-32-characters>

# ---- AI endpoint (server-only; OPTIONAL but powers every AI feature) ----
# Without a key the whole reader + intake surface works; every AI affordance
# reports "AI is not configured" instead of running.
# ANTHROPIC_BASE_URL points the SDK at an internal gateway when the corporate
# network fronts the API; unset talks to api.anthropic.com directly.
ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://your-internal-gateway.example.com
# Model overrides (defaults: claude-sonnet-4-6 for analysis, claude-haiku-4-5
# for the chat surfaces). Change when the gateway exposes different names.
# ATLAS_AI_MODEL=claude-sonnet-4-6
# ATLAS_AI_FAST_MODEL=claude-haiku-4-5

# ---- Datasets portal (OPTIONAL) ----
# PORTAL_KEY is the shared team key that unlocks the billable portal features
# (/datasets/ask and the full-text articles download). Unset means those
# features are off; the dataset catalog and downloads stay public regardless.
# The budget vars cap the portal Ask's daily spend (checked against ai_cost_log
# before every call; both reset at midnight UTC).
# PORTAL_KEY=<choose-a-team-key>
# PORTAL_DAILY_BUDGET_USD=1.00
# PORTAL_DAILY_MAX_CALLS=200
