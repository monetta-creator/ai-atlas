# ---- Runtime database connection (REQUIRED) ----
# PRODUCTION (Vercel / serverless): the direct db.<ref>.supabase.co host is
# IPv6-only and unreachable from serverless. Use the Supabase POOLER (IPv4) and
# set DATABASE_URL — when present, the app connects through it.
#   postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=
# With the transaction pooler, keep one connection per instance:
# DB_POOL_MAX=1

# LOCAL DEV + the migrate/seed scripts use the DIRECT connection (session mode,
# needed for DDL). The app falls back to these when DATABASE_URL is unset.
SUPABASE_DB_HOST=db.<ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<db-password>
SUPABASE_DB_NAME=postgres

# ---- Admin gate (REQUIRED) ----
# Choose a strong admin password. AUTH_SECRET signs the admin session cookie and
# MUST be set (the app throws if it is missing or shorter than 32 chars).
ADMIN_PASSWORD=<choose-a-strong-password>
AUTH_SECRET=<random-string-at-least-32-characters>

# ---- Anthropic API (server-only; REQUIRED for the AI features) ----
# Powers every model call: dossiers, summaries, recommendations, the discovery
# pipeline's web search, Ask/deep research, report generation, and Scout. The
# reader surfaces (map, signals, datasets, traceroute) run without it.
ANTHROPIC_API_KEY=sk-ant-xxx

# ---- arXiv API contact (OPTIONAL) ----
# arXiv asks API clients to identify themselves. Set a contact address to send
# in the research fetcher's User-Agent; unset sends no contact.
# RESEARCH_CONTACT_EMAIL=you@example.com

# ---- Jina Reader (server-only, OPTIONAL) ----
# The discovery pipeline falls back to r.jina.ai for bot-walled/paywalled URLs a
# direct fetch can't read. Works without a key (per-IP rate-limited); a free key
# from https://jina.ai lifts the limit.
# JINA_API_KEY=jina_xxx

# ---- Datasets portal (OPTIONAL) ----
# PORTAL_KEY is the shared team key that unlocks the billable portal features
# (/datasets/ask and the full-text articles download). Unset means those
# features are off; the dataset catalog and downloads stay public regardless.
# The budget vars cap the portal Ask's daily spend (checked against ai_cost_log
# before every call; both reset at midnight UTC).
# PORTAL_KEY=<choose-a-team-key>
# PORTAL_DAILY_BUDGET_USD=1.00
# PORTAL_DAILY_MAX_CALLS=200

# ---- External scan (OPTIONAL) ----
# CRON_SECRET authorizes the daily scan driver at /api/cron/scan. Vercel sends
# it as `Authorization: Bearer <CRON_SECRET>` on cron invocations (vercel.json
# schedules two per day); unset, the route refuses every request.
# SCAN_DAILY_BUDGET_USD caps the scan's model spend per UTC day (web searches +
# Haiku enrichment, summed from ai_cost_log before each billable unit); past
# the cap the run still completes, shipping unenriched items. Feeds are free
# and always run.
# TAVILY_API_KEY switches the scan's search leg from the Sonnet + web_search
# call to Tavily's LLM-free news search (free tier 1,000 queries/month covers
# the weekday cadence); unset, the Anthropic path runs.
# OPENROUTER_API_KEY powers the enrichment models picked on /scan (cheap
# open-weight models via OpenRouter); unset or with no models picked,
# enrichment falls back to claude-haiku-4-5.
# PIPELINE_DAILY_BUDGET_USD caps the discovery pipeline's daily model spend
# (the cron leg checks it before each billable unit; past the cap the run
# fails resumably). Default 1.00.
# CRON_SECRET=<random-string>
# SCAN_DAILY_BUDGET_USD=1.50
# PIPELINE_DAILY_BUDGET_USD=1.00
# TAVILY_API_KEY=tvly-xxx
# OPENROUTER_API_KEY=sk-or-xxx
